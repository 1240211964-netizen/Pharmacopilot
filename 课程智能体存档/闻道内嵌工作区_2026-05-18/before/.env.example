# Copy this file to .env and fill in server-only credentials.
PORT=3000

# Pharmacopilot backend API.
# Never expose SUPABASE_SERVICE_ROLE_KEY or OPENAI_API_KEY to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-materials
MAX_UPLOAD_BYTES=52428800

# Use AI_PROVIDER=mock for local smoke tests without an LLM key.
# Use AI_PROVIDER=openai in production.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# OpenAI-compatible DeepSeek chat provider.
# If DEEPSEEK_API_KEY is set and OPENAI_API_KEY is empty, chat generation uses DeepSeek.
# RAG embeddings still require OPENAI_API_KEY or OPENAI_EMBEDDING_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Required: base URL for the school-authorized Chaoxing/Fanya API gateway.
# Example placeholder only. Use the URL from your school or Chaoxing support.
FANYA_API_BASE_URL=https://your-school-fanya-gateway.example.edu.cn

# Supported auth modes in this connector:
# bearer         -> Authorization: Bearer <FANYA_ACCESS_TOKEN>
# custom-header  -> <FANYA_AUTH_HEADER_NAME>: <FANYA_AUTH_HEADER_VALUE>
# session-cookie -> Cookie: <FANYA_COOKIE>
# app-sign       -> Generic HMAC-SHA256 headers. Confirm the exact signing rules with Chaoxing before using.
FANYA_AUTH_MODE=bearer
FANYA_ACCESS_TOKEN=
FANYA_AUTH_HEADER_NAME=
FANYA_AUTH_HEADER_VALUE=
FANYA_COOKIE=
FANYA_APP_ID=
FANYA_APP_SECRET=

# Optional identifiers used in endpoint templates.
FANYA_SCHOOL_ID=
FANYA_DEFAULT_COURSE_ID=
FANYA_DEFAULT_CLASS_ID=

# Endpoint templates, relative to FANYA_API_BASE_URL.
# Keep these placeholders and replace paths with the exact contract your school/Chaoxing provides.
FANYA_ENDPOINT_HEALTH=/openapi/health
FANYA_ENDPOINT_COURSES=/openapi/courses?schoolId={schoolId}
FANYA_ENDPOINT_ROSTER=/openapi/courses/{courseId}/classes/{classId}/students
FANYA_ENDPOINT_ASSIGNMENTS=/openapi/courses/{courseId}/assignments
FANYA_ENDPOINT_RESOURCES=/openapi/courses/{courseId}/resources
FANYA_ENDPOINT_ANALYTICS=/openapi/courses/{courseId}/analytics

FANYA_TIMEOUT_MS=12000

# Experimental server-side preview for Chaoxing/Fanya knowledge graph.
# This is required when the original Fanya page blocks third-party iframe embedding.
# Keep FANYA_COOKIE or other auth material server-only in .env.
FANYA_KNOWLEDGE_PROXY_ENABLED=false
FANYA_KNOWLEDGE_GRAPH_URL=https://mooc2-ans.chaoxing.com/topic-ans/knowgraph/index.html#/knowledgeMap/frameDiagramTeacher?courseid=251769346&clazzid=131807646
FANYA_KNOWLEDGE_PROXY_HOSTS=mooc2-ans.chaoxing.com

# Pharmacopilot course knowledge RAG.
# Run supabase/migrations/202605060001_knowledge_rag.sql before enabling these APIs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Chinese-character chunking defaults for uploaded PPT, lesson plans, policies, and cases.
RAG_CHUNK_MIN_CHARS=800
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=120
RAG_MATCH_COUNT=8
RAG_MAX_UPLOAD_BYTES=26214400
